# Base URL of the API.
# Development: leave as /api (Vite proxies it to the Express server).
# Production: set to your deployed API, e.g. https://wizhex-api.onrender.com/api
VITE_API_URL=/api

# Where the Vite dev server proxies /api requests (development only)
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Razorpay public key id (test mode, starts with rzp_test_). Safe to expose; the secret stays on the server.
VITE_RAZORPAY_KEY_ID=
