# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/wizhex
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wizhex?retryWrites=true&w=majority
# Not needed when using `npm run dev:memory` (temporary in-memory database).
MONGODB_URI=mongodb://127.0.0.1:27017/wizhex

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API (comma-separated).
CLIENT_URL=http://localhost:5173

# Development-only admin account created by `npm run seed` / `npm run create-admin`.
# Use your own values; the scripts refuse to run in production.
SEED_ADMIN_NAME=WIZHEX Admin
SEED_ADMIN_EMAIL=admin@wizhex.test
SEED_ADMIN_PASSWORD=change-me-Admin123

# Razorpay TEST keys (used in the payments part; leave empty to use simulated payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
